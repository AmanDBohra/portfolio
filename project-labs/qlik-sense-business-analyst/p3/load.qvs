// Master items & governance — Qlik Sense Business Analyst (QSBA)
// Goal: Standardize definitions across the app.
// Concepts: Master dimensions, Master measures, Master visualizations, Drill-down dimensions, Consistency
// Qlik load script starter. Adapt connections/paths to your environment.

Policies:
LOAD
    PolicyID,
    Region,
    Product,
    WrittenPremium,
    IncurredLoss,
    Date(PolicyDate) as PolicyDate
FROM [lib://data/policies.qvd] (qvd);

