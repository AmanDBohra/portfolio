// Storytelling & what-if analysis — Qlik Sense Business Analyst (QSBA)
// Goal: Communicate insight and enable scenario exploration.
// Concepts: Stories & snapshots, Variable input (what-if), Reference lines, Conditional coloring, Accessibility
// Qlik load script starter. Adapt connections/paths to your environment.

Policies:
LOAD
    PolicyID,
    Region,
    Product,
    WrittenPremium,
    IncurredLoss,
    Date(PolicyDate) as PolicyDate
FROM [lib://data/policies.qvd] (qvd);

