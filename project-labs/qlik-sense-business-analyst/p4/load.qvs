// Advanced aggregation with Aggr() — Qlik Sense Business Analyst (QSBA)
// Goal: Compute per-group metrics and rankings.
// Concepts: Aggr(), Rank(), Nested aggregation, TOTAL qualifier, Top-N within groups
// Qlik load script starter. Adapt connections/paths to your environment.

Policies:
LOAD
    PolicyID,
    Region,
    Product,
    WrittenPremium,
    IncurredLoss,
    Date(PolicyDate) as PolicyDate
FROM [lib://data/policies.qvd] (qvd);

