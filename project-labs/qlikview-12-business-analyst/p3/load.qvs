// Set analysis measures — QlikView 12 Business Analyst (QVBA)
// Goal: Deliver YoY, prior-period, and filter-independent metrics.
// Concepts: Set identifiers ($ vs 1), Modifiers, Dollar-sign expansion, Exclusions, YoY growth
// Qlik load script starter. Adapt connections/paths to your environment.

Policies:
LOAD
    PolicyID,
    Region,
    Product,
    WrittenPremium,
    IncurredLoss,
    Date(PolicyDate) as PolicyDate
FROM [lib://data/policies.qvd] (qvd);

