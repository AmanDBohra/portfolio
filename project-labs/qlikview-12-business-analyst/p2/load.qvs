// Expression building & aggregation — QlikView 12 Business Analyst (QVBA)
// Goal: Create robust measures including % of total and rankings.
// Concepts: Sum/Count/Avg, TOTAL qualifier, Rank(), FirstSortedValue, Only()/Dual()
// Qlik load script starter. Adapt connections/paths to your environment.

Policies:
LOAD
    PolicyID,
    Region,
    Product,
    WrittenPremium,
    IncurredLoss,
    Date(PolicyDate) as PolicyDate
FROM [lib://data/policies.qvd] (qvd);

