// Incremental load with inserts, updates & deletes — QlikView 12 Data Architect (QV12DA)
// Goal: Refresh large facts efficiently and correctly.
// Concepts: Incremental load, WHERE NOT EXISTS, Delete reconciliation, Optimized QVD (WHERE EXISTS exception), Peek/Max for cutoffs
// Qlik load script starter. Adapt connections/paths to your environment.

Policies:
LOAD
    PolicyID,
    Region,
    Product,
    WrittenPremium,
    IncurredLoss,
    Date(PolicyDate) as PolicyDate
FROM [lib://data/policies.qvd] (qvd);

