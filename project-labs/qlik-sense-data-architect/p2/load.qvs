// QVD staging & incremental load — Qlik Sense Data Architect (QSDA 2024)
// Goal: Speed reloads by staging to QVDs and loading only new/changed rows.
// Concepts: QVD (optimized load), Incremental load, WHERE NOT EXISTS, STORE/LOAD, Handling updates/deletes
// Qlik load script starter. Adapt connections/paths to your environment.

Policies:
LOAD
    PolicyID,
    Region,
    Product,
    WrittenPremium,
    IncurredLoss,
    Date(PolicyDate) as PolicyDate
FROM [lib://data/policies.qvd] (qvd);

